{
  "name": "g2-dash",
  "version": "4.0.0",
  "private": true,
  "description": "Dashboard for electric scooters with VESC controllers",
  "scripts": {
    "ios:add": "npx cap add ios && sh scripts/patch-ios.sh",
    "icons": "npx capacitor-assets generate --ios",
    "sync": "npx cap sync ios",
    "open": "npx cap open ios",
    "android:add": "npx cap add android && sh scripts/patch-android.sh",
    "android:icons": "npx capacitor-assets generate --android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/haptics": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0"
  }
}